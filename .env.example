# GEMINI_API_KEY: Optional, required only for the AI Chat Assistant (server-side only).
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Express API server port
PORT=5000

# Allowed browser origin for CORS (use http://localhost:3000 for AI Studio preview or http://localhost:5173 for standalone Vite)
CLIENT_ORIGIN=http://localhost:5173
